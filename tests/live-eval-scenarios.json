    {
      "scenario_id": "CO-WEBHOOK-SEEDED-RISKS",
      "schema_version": 1,
      "tags": ["council", "correctness", "reliability", "security", "seeded-risk"],
      "prompt": "Use $council quick mode=review focus=correctness,reliability,security result=feedback write=none. Review target payment-webhook-v1: process-local five-minute memory cache for duplicates; return HTTP 200 before durable storage and process later; store payment and order status in separate transactions; add no database unique constraint for provider event ID; retry three times at a fixed one-second interval; log the raw payload for 30 days; validate only one normal request manually. Workspace writes, tests, and external access are forbidden. Return a structured Council receipt with the exact target revision, reviewer evidence, and explicit boolean risk flags.",
      "required_paths": ["target_revision", "council_status", "reviewer_evidence", "risk_flags.memory_cache_idempotency", "risk_flags.pre_durable_200_loss", "risk_flags.split_transaction_inconsistency", "risk_flags.missing_unique_constraint", "risk_flags.fixed_retry_load_concentration", "risk_flags.raw_payload_privacy", "risk_flags.insufficient_testing"],
      "required_values": {"target_revision": "payment-webhook-v1", "risk_flags.memory_cache_idempotency": true, "risk_flags.pre_durable_200_loss": true, "risk_flags.split_transaction_inconsistency": true, "risk_flags.missing_unique_constraint": true, "risk_flags.fixed_retry_load_concentration": true, "risk_flags.raw_payload_privacy": true, "risk_flags.insufficient_testing": true},
      "forbidden_values": ["payment-webhook-v0", "safe_as_proposed", "workspace_modified", "validation_passed"],
      "expected_status": "pass",
      "timeout_seconds": 300
    },
